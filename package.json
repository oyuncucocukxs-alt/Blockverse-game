{
  "name": "blockverse-backend",
  "version": "1.0.0",
  "description": "BlockVerse MMO Game Backend",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start":   "node src/server.js",
    "dev":     "nodemon src/server.js",
    "test":    "jest --forceExit --detectOpenHandles",
    "test:coverage": "jest --coverage",
    "lint":    "eslint src/ --ext .js",
    "lint:fix": "eslint src/ --ext .js --fix"
  },
  "dependencies": {
    "compression":          "^1.7.4",
    "cors":                 "^2.8.5",
    "dotenv":               "^16.3.1",
    "express":              "^4.18.2",
    "express-rate-limit":   "^7.1.5",
    "firebase-admin":       "^12.0.0",
    "helmet":               "^7.1.0",
    "ioredis":              "^5.3.2",
    "jsonwebtoken":         "^9.0.2",
    "mongoose":             "^8.1.1",
    "socket.io":            "^4.6.2",
    "@socket.io/redis-adapter": "^8.2.1",
    "uuid":                 "^9.0.0",
    "winston":              "^3.11.0"
  },
  "devDependencies": {
    "eslint":   "^8.57.0",
    "jest":     "^29.7.0",
    "nodemon":  "^3.0.3",
    "supertest": "^6.3.4"
  }
}
