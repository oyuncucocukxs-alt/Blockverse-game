# ─── BlockVerse Environment Config ───────────────────────────
# Copy to .env and fill in values. NEVER commit .env to source control.

# ── Server ──────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# ── MongoDB ──────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/blockverse
MONGO_ROOT_USER=admin
MONGO_ROOT_PASS=CHANGE_ME_STRONG_PASSWORD

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ── JWT ──────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_JWT_SECRET_64_CHARS_MIN

# ── Game Server Auth ──────────────────────────────────────────
# Shared secret between Node.js API and Unity dedicated server
GAME_SERVER_SECRET=CHANGE_ME_SERVER_SECRET

# ── Firebase ─────────────────────────────────────────────────
# Paste the full JSON of your Firebase Admin SDK service account
FIREBASE_ADMIN_SDK_JSON={"type":"service_account","project_id":"..."}

# ── Monitoring ───────────────────────────────────────────────
GRAFANA_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# ── CDN / Assets ─────────────────────────────────────────────
ASSET_CDN_URL=https://assets.blockverse.io
ADDRESSABLES_REMOTE_URL=https://assets.blockverse.io/addressables

# ── Game Config ──────────────────────────────────────────────
MAX_PLAYERS_PER_WORLD=50
MAX_WORLD_SIZE=30000
GROWTH_SPEED_MULTIPLIER=1.0
